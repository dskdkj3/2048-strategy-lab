__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.direnv/

# Experiment outputs and profiles are reproducible artifacts, not source.
/artifacts/
/profiles/
/checkpoints/
*.npz
*.prof
*.ckpt

# External/native research checkouts and weights are never vendored.
/external/
/weights/
*.bin
*.safetensors
*.pt
*.pth
*.onnx

# Local secrets and machine-specific config.
.env
*.local.toml
